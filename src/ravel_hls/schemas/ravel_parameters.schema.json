{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/albertc9/RAVEL/schemas/ravel_parameters.schema.json",
  "title": "RAVEL ModelGraph parameter package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "generation",
    "model_family",
    "model_structure_sha256",
    "frontend_provenance",
    "model_facts",
    "entries",
    "compatibility_sha256",
    "parameter_state_sha256",
    "known_answer_evidence",
    "package_content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "format": {"const": "ravel-modelgraph-parameters"},
    "generation": {"type": "object"},
    "model_family": {"type": "object"},
    "model_structure_sha256": {"$ref": "#/$defs/sha256"},
    "frontend_provenance": {"type": "object"},
    "model_facts": {"type": "object"},
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation_id",
          "role",
          "shape",
          "dtype",
          "numeric_type",
          "storage",
          "sha256"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$"},
          "operation_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "role": {"enum": ["weight", "bias"]},
          "shape": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "dtype": {"type": "string", "minLength": 1},
          "numeric_type": {"type": "object"},
          "storage": {"type": "string", "pattern": "^arrays/[0-9]{4}\\.npy$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "compatibility_sha256": {"$ref": "#/$defs/sha256"},
    "parameter_state_sha256": {"$ref": "#/$defs/sha256"},
    "known_answer_evidence": {"type": ["object", "null"]},
    "package_content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
