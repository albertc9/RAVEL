{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/albertc9/RAVEL/schemas/ravel_config.schema.json",
  "title": "RAVEL Aria 1.7.2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["HLS"],
  "properties": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ForceReplace": {"type": "boolean", "default": false}
      }
    },
    "HLS": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Backend": {"const": "Vitis", "default": "Vitis"},
        "IOType": {"const": "io_stream", "default": "io_stream"},
        "Part": {"type": ["string", "null"]},
        "ClockPeriod": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "Optimization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "TemporalPacking": {"enum": [2, 4, 8], "default": 8},
        "DenseParallelism": {"enum": [1, 2, 4], "default": 4},
        "TargetII": {"type": "integer", "minimum": 1, "description": "Optional best-effort per-core initiation interval in clock cycles."},
        "ResourceLimits": {
          "type": "object", "additionalProperties": false,
          "description": "Optional per-core ceilings; BRAM is counted in 18-Kib blocks.",
          "properties": {
            "LUT": {"type": "integer", "minimum": 0},
            "FF": {"type": "integer", "minimum": 0},
            "DSP": {"type": "integer", "minimum": 0},
            "BRAM": {"type": "integer", "minimum": 0}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"TemporalPacking": {"const": 8}},
            "required": ["TemporalPacking"]
          },
          "then": {
            "properties": {"DenseParallelism": {"const": 4}},
            "required": ["DenseParallelism"]
          }
        },
        {
          "if": {
            "properties": {"DenseParallelism": {"const": 4}},
            "required": ["DenseParallelism"]
          },
          "then": {
            "properties": {"TemporalPacking": {"const": 8}},
            "required": ["TemporalPacking"]
          }
        }
      ]
    },
    "Verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Mode": {
          "enum": ["auto", "required", "disabled"],
          "default": "auto"
        },
        "Samples": {"type": "integer", "minimum": 1},
        "Seed": {"type": "integer", "minimum": 0}
      }
    },
    "Vitis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Run": {"type": "boolean", "default": false},
        "Stages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Reset": {"type": "boolean", "default": true},
            "CSim": {"type": "boolean", "default": false},
            "Synth": {"type": "boolean", "default": true},
            "CoSim": {"type": "boolean", "default": false},
            "Validation": {"type": "boolean", "default": false},
            "Export": {"type": "boolean", "default": false},
            "VSynth": {"type": "boolean", "default": false}
          }
        }
      }
    }
  }
}
