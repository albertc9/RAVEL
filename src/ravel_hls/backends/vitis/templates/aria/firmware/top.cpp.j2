#include <iostream>

#include "{{ project_name }}.h"
#include "parameters.h"
#include "nnet_utils/nnet_aria.h"

void {{ project_name }}(
    hls::stream<{{ input_wide_type }}> &{{ input_name }},
    hls::stream<{{ output_type }}> &{{ output_name }}
) {
    #pragma HLS INTERFACE axis port={{ input_name }},{{ output_name }}
    #pragma HLS DATAFLOW disable_start_propagation

#ifndef __SYNTHESIS__
    static bool loaded_weights = false;
    if (!loaded_weights) {
        nnet::load_weights_from_txt<{{ conv_weight.type_name }}, {{ conv_weight.length }}>({{ conv_weight.name }}, "{{ conv_weight.name }}.txt");
        nnet::load_weights_from_txt<{{ conv_bias.type_name }}, {{ conv_bias.length }}>({{ conv_bias.name }}, "{{ conv_bias.name }}.txt");
        nnet::load_weights_from_txt<{{ dense_weight.type_name }}, {{ dense_weight.length }}>({{ dense_weight.name }}, "{{ dense_weight.name }}.txt");
        nnet::load_weights_from_txt<{{ dense_bias.type_name }}, {{ dense_bias.length }}>({{ dense_bias.name }}, "{{ dense_bias.name }}.txt");
        loaded_weights = true;
    }
#endif

    hls::stream<{{ conv_wide_type }}> {{ conv_stream }}("{{ conv_stream }}");
    #pragma HLS STREAM variable={{ conv_stream }} depth=4
    #pragma HLS BIND_STORAGE variable={{ conv_stream }} type=fifo impl=srl

    hls::stream<{{ activation_wide_type }}> {{ activation_stream }}("{{ activation_stream }}");
    #pragma HLS STREAM variable={{ activation_stream }} depth=4
    #pragma HLS BIND_STORAGE variable={{ activation_stream }} type=fifo impl=srl

    hls::stream<{{ pool_wide_type }}> {{ pool_stream }}("{{ pool_stream }}");
    #pragma HLS STREAM variable={{ pool_stream }} depth=4
    #pragma HLS BIND_STORAGE variable={{ pool_stream }} type=fifo impl=srl

    nnet::first_conv_2row_4lane_temporal_wide_cl<{{ input_wide_type }}, {{ conv_wide_type }}, {{ conv_config }}>(
        {{ input_name }}, {{ conv_stream }}, {{ conv_weight.name }}, {{ conv_bias.name }});
    nnet::relu<{{ conv_wide_type }}, {{ activation_wide_type }}, {{ activation_config }}>(
        {{ conv_stream }}, {{ activation_stream }});
    nnet::maxpool2d_wide_nonoverlap_cl<{{ activation_wide_type }}, {{ pool_wide_type }}, {{ pool_config }}>(
        {{ activation_stream }}, {{ pool_stream }});
    nnet::dense_wide_stream<{{ pool_wide_type }}, {{ output_type }}, {{ dense_config }}>(
        {{ pool_stream }}, {{ output_name }}, {{ dense_weight.name }}, {{ dense_bias.name }});
}
