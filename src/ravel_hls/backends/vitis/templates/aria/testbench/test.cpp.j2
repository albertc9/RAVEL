#include <cstring>
#include <fstream>
#include <iostream>
#include <map>
#include <string>
#include <vector>

#include "firmware/{{ project_name }}.h"
#include "firmware/nnet_utils/nnet_helpers.h"

namespace nnet {
bool trace_enabled = true;
std::map<std::string, void *> *trace_outputs = NULL;
size_t trace_type_size = sizeof(double);
} // namespace nnet

void pack_aria_test_input(
    const std::vector<float> &logical_input,
    hls::stream<{{ input_wide_type }}> &packed_input
) {
    for (unsigned word_index = 0; word_index < {{ input_words_per_inference }}; word_index++) {
        {{ input_wide_type }} word;
        for (unsigned row = 0; row < {{ temporal_pack }}; row++) {
            for (unsigned channel = 0; channel < {{ channels_per_row }}; channel++) {
                word[row * {{ channels_per_row }} + channel] = logical_input[(word_index * {{ temporal_pack }} + row) * {{ channels_per_row }} + channel];
            }
        }
        packed_input.write(word);
    }
}

int main() {
    std::ifstream input_file("tb_data/tb_input_features.dat");
#ifdef RTL_SIM
    const char *results_path = "tb_data/rtl_cosim_results.log";
#else
    const char *results_path = "tb_data/csim_results.log";
#endif
    std::ofstream results(results_path);
    std::string line;
    unsigned sample = 0;
    while (std::getline(input_file, line)) {
        std::vector<float> input;
        char *text = const_cast<char *>(line.c_str());
        for (char *token = std::strtok(text, " "); token != NULL; token = std::strtok(NULL, " ")) {
            input.push_back(std::atof(token));
        }
        if (input.size() != {{ input_values_per_inference }}) {
            std::cerr << "Expected {{ input_values_per_inference }} input values, received " << input.size() << std::endl;
            return 2;
        }
        hls::stream<{{ input_wide_type }}> {{ input_name }}("{{ input_name }}");
        hls::stream<{{ output_type }}> {{ output_name }}("{{ output_name }}");
        pack_aria_test_input(input, {{ input_name }});
        {{ project_name }}({{ input_name }}, {{ output_name }});
        nnet::print_result<{{ output_type }}, 1>({{ output_name }}, results);
        sample++;
    }

    if (sample == 0) {
        std::vector<float> zero_input({{ input_values_per_inference }}, 0.0f);
        hls::stream<{{ input_wide_type }}> {{ input_name }}("{{ input_name }}");
        hls::stream<{{ output_type }}> {{ output_name }}("{{ output_name }}");
        pack_aria_test_input(zero_input, {{ input_name }});
        {{ project_name }}({{ input_name }}, {{ output_name }});
        nnet::print_result<{{ output_type }}, 1>({{ output_name }}, results);
    }
    std::cout << "INFO: Saved inference results to file: " << results_path << std::endl;
    return 0;
}
